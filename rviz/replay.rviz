Panels:
  - Class: rviz/Displays
    Help Height: 133
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
      Splitter Ratio: 0.5
    Tree Height: 945
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: left_Img
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 371
  - Class: rviz_visual_tools/RvizVisualToolsGui
    Name: RvizVisualToolsGui
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /left_rgb/image_raw
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: left_Img
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true
    - Alpha: 1
      Axes Length: 1
      Axes Radius: 0.10000000149011612
      Class: rviz/Pose
      Color: 255; 25; 0
      Enabled: false
      Head Length: 0.019999999552965164
      Head Radius: 0.019999999552965164
      Name: Pose
      Queue Size: 10
      Shaft Length: 0.10000000149011612
      Shaft Radius: 0.009999999776482582
      Shape: Arrow
      Topic: /left_clamp/pose
      Unreliable: false
      Value: false
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
        left_base:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        left_clamp_base:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        left_left_finger:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        left_pose_pitch_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        left_pose_x_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        left_pose_y_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        left_pose_yaw_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        left_pose_z_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        left_rail:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        left_right_finger:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        right_base:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        right_clamp_base:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        right_left_finger:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        right_pose_pitch_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        right_pose_x_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        right_pose_y_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        right_pose_yaw_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        right_pose_z_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        right_rail:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        right_right_finger:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        table:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        world:
          Alpha: 1
          Show Axes: false
          Show Trail: false
      Name: Clamp RobotModel
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /right_rgb/image_raw
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: right_Img
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /clamp_tip_trails
      Name: Clamp Tip Trails
      Namespaces:
        clamp_tip_trail: true
      Queue Size: 100
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Theta std deviation: 0.2617993950843811
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 2.0127058029174805
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.7853981852531433
      Focal Point:
        X: 0.37192636728286743
        Y: 0.06866854429244995
        Z: 0.19771221280097961
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.600398063659668
      Target Frame: <Fixed Frame>
      Yaw: 2.5204272270202637
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1326
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  RvizVisualToolsGui:
    collapsed: false
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 2560
  X: 0
  Y: 27
